# Showcase build (vite --mode showcase): public design preview. Contains NO secrets.
VITE_DEMO_MODE=showcase

# Safety net: values in .env.showcase override .env / .env.local, so even if a developer has real
# keys in .env.local they can never end up in the showcase bundle. Keep these blank.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
